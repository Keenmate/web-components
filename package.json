{
  "name": "@keenmate/web-components-devkit",
  "version": "0.1.0",
  "description": "Shared dev, example-site and build infrastructure for KeenMate web components: Vite preset, examples kit (chapter nav, copy-link, controls store, shared styles), Playwright preset and the `kmwc` CLI (sync, doctor, check-vars, new, readme).",
  "type": "module",
  "license": "MIT",
  "author": "KeenMate",
  "homepage": "https://github.com/keenmate/web-components",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keenmate/web-components.git"
  },
  "bin": {
    "kmwc": "./src/cli/kmwc.js"
  },
  "exports": {
    ".": {
      "types": "./src/config.d.ts",
      "import": "./src/config.js"
    },
    "./vite": {
      "types": "./src/vite/index.d.ts",
      "import": "./src/vite/index.js"
    },
    "./playwright": {
      "types": "./src/playwright/index.d.ts",
      "import": "./src/playwright/index.js"
    },
    "./examples": {
      "types": "./src/examples/index.d.ts",
      "import": "./src/examples/index.js"
    },
    "./examples/auto": "./src/examples/auto.js",
    "./examples/style.css": "./src/examples/css/style.css",
    "./components.json": "./components.json",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "templates",
    "components.json",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "readme": "node src/cli/kmwc.js readme",
    "readme:check": "node src/cli/kmwc.js readme --check",
    "test": "node --test \"test/**/*.test.js\"",
    "test:e2e": "cd playground && npx playwright test",
    "playground": "cd playground && vite",
    "playground:build": "cd playground && vite build --mode examples",
    "playground:lib": "cd playground && vite build"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "vite-plugin-dts": "^4.5.4"
  },
  "peerDependencies": {
    "@playwright/test": "^1.60.0",
    "vite": "^7.0.0"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    }
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^7.3.7"
  },
  "engines": {
    "node": ">=20.19"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
