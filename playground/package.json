{
  "name": "@keenmate/web-playground",
  "version": "0.1.0",
  "description": "Devkit test bed — exercises the Vite preset, examples kit and CLI end-to-end.",
  "type": "module",
  "license": "MIT",
  "author": "Keenmate s.r.o.",
  "homepage": "https://github.com/keenmate/web-playground",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keenmate/web-playground.git"
  },
  "keywords": [
    "web-components",
    "custom-elements",
    "keenmate",
    "bliss",
    "web-playground"
  ],
  "main": "./dist/web-playground.umd.js",
  "module": "./dist/web-playground.js",
  "types": "./dist/index.d.ts",
  "customElements": "custom-elements.json",
  "web-types": "web-types.json",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/web-playground.js",
      "require": "./dist/web-playground.umd.js"
    },
    "./style.css": "./dist/style.css",
    "./manifest": "./component-variables.manifest.json",
    "./component-variables.manifest.json": "./component-variables.manifest.json",
    "./custom-elements.json": "./custom-elements.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs",
    "component-variables.manifest.json",
    "custom-elements.json",
    "web-types.json",
    "vscode.html-custom-data.json",
    "vscode.css-custom-data.json",
    "!**/CLAUDE.md",
    "!**/.claude"
  ],
  "sideEffects": [
    "./dist/*.js",
    "./dist/*.css",
    "./src/index.ts",
    "./src/web-component.ts",
    "./src/css/*.css"
  ],
  "kmwc": {
    "title": "Web Playground",
    "tagline": "Devkit test bed — exercises the Vite preset, examples kit and CLI end-to-end.",
    "tag": "web-playground",
    "prefix": "pg",
    "library": {
      "globalName": "WebPlayground",
      "fileName": "web-playground"
    },
    "ports": {
      "dev": 17300,
      "image": 17310
    },
    "theme": {
      "accentColor": "#059669",
      "accentEndColor": "#065f46"
    }
  },
  "scripts": {
    "dev": "vite",
    "analyze": "cem analyze",
    "build": "npm run check:vars && npm run analyze && tsc --noEmit && vite build",
    "build:examples": "vite build --mode examples",
    "preview:examples": "vite preview --mode examples",
    "typecheck": "tsc --noEmit",
    "check:vars": "kmwc check-vars --strict",
    "doctor": "kmwc doctor",
    "prepublishOnly": "npm run clean:dist && npm run build",
    "clean:dist": "node -e \"for (const p of ['dist']) require('fs').rmSync(p,{recursive:true,force:true})\"",
    "clean": "node -e \"for (const p of ['dist','dist-examples']) require('fs').rmSync(p,{recursive:true,force:true})\"",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "@keenmate/web-components-core": "file:../../web-components-core"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@keenmate/web-components-devkit": "file:..",
    "@playwright/test": "^1.60.0",
    "custom-element-jet-brains-integration": "^1.7.0",
    "custom-element-vs-code-integration": "^1.5.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.7"
  },
  "private": true,
  "allowScripts": {
    "esbuild": true
  }
}
